/* Tela de controles: o botão Iniciar (.IniciarBtn) e a moldura seguem o Tema.uss. */

.titulo-controles {
    flex-shrink: 0;
    flex-grow: 0;
    width: auto;
    font-size: 65px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    color: rgb(193, 112, 207);
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: rgb(153, 0, 178);
    letter-spacing: 10px;
}
