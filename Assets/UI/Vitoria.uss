/* Tela de Vitória: fundo escuro, título dourado, subtítulo e botão para jogar de novo. Mesmo molde do GameOver.uss. */

/* Moldura do conteúdo: aparência do Tema.uss (.vit-moldura). */
.vit-moldura {
    padding: 40px 80px 48px 80px;
    align-items: center;
}

/* Tela cheia escurecida. Fica escondida até o código mostrar (style.display = flex). */
.vit-raiz {
    display: none;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(4, 8, 24, 0.85);
}

.vit-titulo {
    margin: 0 0 12px 0;
    color: rgb(255, 221, 87);
    font-size: 120px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: rgb(120, 60, 0);
    text-shadow: 0 6px 14px rgba(0, 0, 0, 0.9);
}

.vit-subtitulo {
    margin: 0 0 48px 0;
    color: rgb(255, 255, 255);
    font-size: 44px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

/* Layout do botão; a aparência (cores, borda e hover) é do Tema.uss. */
.vit-raiz .vit-botao {
    width: 420px;
    padding: 18px 24px;
    margin: 0;
    font-size: 38px;
}
