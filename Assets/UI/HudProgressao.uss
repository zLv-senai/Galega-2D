/* HUD de progressão. Texto branco e barra ciano para ler bem sobre o fundo escuro do espaço. */

.hud-raiz {
    flex-grow: 1;
}

/* Canto superior esquerdo */
.painel-status {
    position: absolute;
    left: 16px;
    top: 16px;
    width: 300px;
    padding: 10px 14px;
    background-color: rgba(8, 10, 28, 0.6);
    border-width: 2px;
    border-color: rgba(0, 229, 255, 0.55);
    border-radius: 10px;
}

.hud-texto {
    margin: 0;
    padding: 0;
    color: rgb(255, 255, 255);
    font-size: 22px;
    -unity-font-style: bold;
    text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.95);
}

.hud-level {
    font-size: 30px;
    margin-bottom: 6px;
}

/* Barra de XP: o fundo tem tamanho fixo e o preenchimento muda de largura (em %) pelo código */
.xp-fundo {
    height: 14px;
    margin-bottom: 8px;
    background-color: rgba(255, 255, 255, 0.15);
    border-width: 1px;
    border-color: rgba(0, 229, 255, 0.7);
    border-radius: 7px;
    overflow: hidden;
}

.xp-preenchimento {
    width: 0%;
    height: 100%;
    background-color: rgb(0, 229, 255);
}

.hud-escudo {
    margin-top: 2px;
    color: rgb(120, 240, 255);
}

/* À direita do painel de level (16 + 300 + 2x14 de padding + 2x2 de borda + 12 de espaço = 360) */
.powerups-ativos {
    display: none;
    position: absolute;
    left: 360px;
    top: 16px;
    padding: 10px 14px;
    background-color: rgba(8, 10, 28, 0.6);
    border-width: 2px;
    border-color: rgba(0, 229, 255, 0.55);
    border-radius: 10px;
}

.powerup-linha {
    margin-bottom: 2px;
}

/* Centro-alto: aviso de level up (escondido por padrão) */
.levelup-painel {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    top: 12%;
    align-items: center;
}

.levelup-titulo {
    color: rgb(255, 221, 87);
    font-size: 84px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(120, 60, 0);
    text-shadow: 0 4px 10px rgba(0, 0, 0, 0.9);
}

/* Centro-baixo: aviso do power-up pego (escondido por padrão; a cor vem do PowerUpData) */
.powerup-aviso {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    bottom: 18%;
    margin: 0;
    color: rgb(255, 255, 255);
    font-size: 44px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(0, 0, 0);
    text-shadow: 0 3px 8px rgba(0, 0, 0, 0.9);
}

.levelup-nivel {
    font-size: 40px;
    -unity-text-align: middle-center;
}

/* Barra de AMEAÇA, logo abaixo da barra de XP (o preenchimento muda de largura, em %, pelo código) */
.ameaca-bloco {
    margin-bottom: 8px;
}

.ameaca-titulo {
    font-size: 14px;
    margin-bottom: 2px;
    color: rgb(255, 170, 90);
}

.ameaca-fundo {
    height: 10px;
    background-color: rgba(255, 255, 255, 0.15);
    border-width: 1px;
    border-color: rgba(255, 110, 50, 0.8);
    border-radius: 5px;
    overflow: hidden;
}

.ameaca-preenchimento {
    width: 0%;
    height: 100%;
    background-color: rgb(255, 80, 30);
}

/* Waves: bloco com a wave atual e os inimigos que faltam, abaixo da barra de XP */
.wave-bloco {
    margin-bottom: 8px;
}

.hud-wave {
    margin-bottom: 2px;
    color: rgb(255, 221, 87);
}

/* Centro: anúncio da wave (escondido por padrão). A classe wave-anuncio-boss deixa o texto vermelho. */
.wave-anuncio {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    top: 36%;
    margin: 0;
    color: rgb(255, 255, 255);
    font-size: 96px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(0, 60, 80);
    text-shadow: 0 4px 10px rgba(0, 0, 0, 0.9);
}

.wave-anuncio-boss {
    color: rgb(255, 70, 50);
    -unity-text-outline-color: rgb(90, 0, 0);
}

/* Centro-alto: alerta de boss (escondido por padrão; pisca pelo código via opacity) */
.boss-alerta {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    top: 30%;
    margin: 0;
    color: rgb(255, 70, 50);
    font-size: 72px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(90, 0, 0);
    text-shadow: 0 4px 10px rgba(0, 0, 0, 0.9);
}

/* Topo central: barra de vida do boss (escondida por padrão; só aparece com boss vivo) */
.boss-barra {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    top: 16px;
    align-items: center;
}

.boss-titulo {
    font-size: 26px;
    margin-bottom: 4px;
    color: rgb(255, 120, 100);
}

.boss-vida-fundo {
    width: 700px;
    height: 22px;
    background-color: rgba(0, 0, 0, 0.55);
    border-width: 2px;
    border-color: rgb(255, 80, 70);
    border-radius: 11px;
    overflow: hidden;
}

.boss-vida-preenchimento {
    width: 100%;
    height: 100%;
    background-color: rgb(235, 40, 50);
}

/* Seta que aponta para o boss fora da tela (escondida por padrão). O SetaDoBoss.cs move com translate,
   gira com rotate e desenha o triângulo com Painter2D (não depende de fonte). O tamanho vem do código. */
.seta-boss {
    display: none;
    position: absolute;
    left: 0;
    top: 0;
    width: 44px;
    height: 44px;
    transform-origin: center;
}
