<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Scripts/Menu/ControlsMenu.uss?fileID=7433441132597879392&amp;guid=d3b5a5de3a64c68438eb0e1bd9899232&amp;type=3#ControlsMenu"/>
    <ui:VisualElement style="flex-grow: 1; width: 100%; height: 100%; justify-content: center; align-items: center;">
        <ui:GroupBox name="MenuGroup" style="height: 70%; width: 70%; justify-content: flex-start; align-items: auto; align-self: auto; align-content: auto; flex-direction: column; flex-wrap: nowrap; flex-grow: 1; margin-top: 6px; padding-top: 5px; background-color: rgba(0, 0, 47, 0.447); margin-bottom: 6px; flex-shrink: 0; border-top-width: 8px; border-right-width: 8px; border-bottom-width: 8px; border-left-width: 8px; border-left-color: rgb(255, 0, 236); border-right-color: rgb(255, 0, 236); border-top-color: rgb(255, 0, 236); border-bottom-color: rgb(255, 0, 236); border-top-left-radius: 25px; border-top-right-radius: 25px; border-bottom-right-radius: 25px; border-bottom-left-radius: 25px; max-height: 80%; bottom: auto; top: auto; right: auto; position: absolute; left: auto;">
            <ui:GroupBox name="Controls" style="flex-grow: 1; width: 100%; height: 100%; justify-content: center; align-items: stretch; align-self: auto; align-content: auto;">
                <ui:Label text="Controles" style="font-size: 65px; -unity-text-align: middle-center; color: rgb(201, 42, 173); flex-shrink: 0; flex-grow: 0; width: auto; -unity-font-style: bold; text-shadow: 4px 3px 2px rgb(67, 108, 107); -unity-text-outline-width: 2px; -unity-text-outline-color: rgb(66, 188, 184); letter-spacing: 10px; word-spacing: 0; top: 0; flex-direction: column; align-content: auto; align-self: auto; justify-content: flex-start; align-items: auto; position: absolute; right: 0; left: 0;"/>
                <ui:GroupBox name="ControlsGroup" style="width: auto; height: auto; min-height: auto; min-width: auto; -unity-text-outline-width: 8px; -unity-text-outline-color: rgb(201, 42, 173); color: rgb(255, 255, 255); max-height: 70%; max-width: 100%; background-color: rgba(140, 81, 139, 0); text-shadow: 0 0 0 rgba(0, 0, 0, 0); flex-direction: row; background-image: url(&quot;project://database/Assets/Images/Controls.png?fileID=2800000&amp;guid=cb3f0ac41661eb542801412d9b5c46c4&amp;type=3#Controls&quot;); flex-grow: 1; justify-content: flex-start; align-content: auto; align-self: auto; align-items: stretch; right: 0; left: 0; bottom: auto; top: auto;">
                    <ui:GroupBox style="bottom: 2px; position: absolute; width: 94%; height: 20%; align-content: auto; justify-content: space-around; flex-direction: row; align-items: flex-start; flex-grow: 0; left: 5%; right: auto; margin-left: 0; margin-right: 0; flex-shrink: 1; padding-right: 0%; padding-left: 0%; align-self: auto; -unity-text-outline-color: rgb(201, 42, 173); font-size: 30px; color: rgb(255, 255, 255); -unity-text-outline-width: 2px; -unity-font-style: bold;">
                        <ui:Label text="Mover a nave" name="Move" enable-rich-text="false" style="position: relative; bottom: auto; justify-content: flex-start; align-self: auto; align-content: auto; align-items: auto;"/>
                        <ui:Label text="Mirar / Atirar" name="Look" style="position: relative; bottom: auto; justify-content: flex-start; align-self: auto; align-content: auto; align-items: auto;"/>
                        <ui:Label text="Pausar" name="Pause" style="position: relative; bottom: auto; justify-content: flex-start; align-self: auto; align-content: auto; align-items: auto;"/>
                        <ui:Label text="Aceitar / Pausar" name="Enter" style="position: relative; bottom: auto; justify-content: flex-start; align-self: auto; align-content: auto; align-items: auto;"/>
                    </ui:GroupBox>
                </ui:GroupBox>
            </ui:GroupBox>
            <!-- Iniciar vem depois de Controls: o ultimo filho fica por cima e recebe o clique. -->
            <ui:Button text="Iniciar" name="Iniciar" class="IniciarBtn" style="bottom: 5%; position: absolute; right: 5%; -unity-font-style: bold; font-size: 32px; color: rgb(201, 42, 173); -unity-text-outline-width: 0; -unity-text-outline-color: rgb(66, 188, 184); background-color: rgba(188, 188, 188, 0); border-top-width: 3px; border-right-width: 3px; border-bottom-width: 3px; border-left-width: 3px; border-top-left-radius: 16px; border-top-right-radius: 16px; border-bottom-right-radius: 16px; border-bottom-left-radius: 16px; border-left-color: rgb(66, 188, 184); border-right-color: rgb(66, 188, 184); border-top-color: rgb(66, 188, 184); border-bottom-color: rgb(66, 188, 184); backdrop-filter: none; text-shadow: 4px 3px 1px rgb(67, 108, 107);"/>
        </ui:GroupBox>
    </ui:VisualElement>
</ui:UXML>
