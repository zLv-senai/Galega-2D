/* Tela de Game Over: fundo escuro, título vermelho, level alcançado e botão para reiniciar. */

/* Tela cheia escurecida. Fica escondida até o código mostrar (style.display = flex). */
.go-raiz {
    display: none;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(12, 0, 6, 0.85);
}

.go-titulo {
    margin: 0 0 12px 0;
    color: rgb(255, 60, 90);
    font-size: 120px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: rgb(90, 0, 20);
    text-shadow: 0 6px 14px rgba(0, 0, 0, 0.9);
}

/* Integração: agrupa as linhas do resumo (level, wave, recorde). A margem de baixo que era do .go-level (48px) passou para cá. */
.go-resumo {
    margin: 0 0 40px 0;
    align-items: center;
}

.go-level {
    margin: 0 0 8px 0;
    color: rgb(255, 255, 255);
    font-size: 44px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

/* Ranking local (Infinito): destaque em dourado. Vem depois do .go-level, então a cor e o tamanho daqui valem. */
.go-ranking {
    color: rgb(255, 215, 90);
    font-size: 38px;
}

/* O seletor ".go-raiz .go-botao" é mais forte que o estilo padrão do botão (inclusive no :hover). */
.go-raiz .go-botao {
    width: 420px;
    padding: 18px 24px;
    margin: 0;
    font-size: 38px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    background-color: rgb(40, 110, 200);
    border-width: 4px;
    border-radius: 14px;
    border-color: rgb(120, 190, 255);
}

.go-raiz .go-botao:hover {
    background-color: rgb(60, 140, 235);
    border-color: rgb(190, 225, 255);
}

.go-raiz .go-botao:active {
    background-color: rgb(30, 85, 160);
}
