/* Tela de Game Over no estilo arcade do menu: moldura roxa, título com sombra deslocada e botões de cantos opostos arredondados.
   Cores, moldura e estado dos botões vêm do Tema.uss. Tamanhos pensados para a resolução de referência do painel (1920x1080). */

/* Tela cheia escurecida. Fica escondida até o código mostrar (style.display = flex); entra com fade. */
.go-raiz {
    display: none;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(12, 0, 18, 0.72);
    opacity: 0;
    transition: opacity 0.4s ease-out;
}

.go-moldura {
    width: 86%;
    max-height: 94%;
    padding: 12px 28px 22px 28px;
    align-items: center;
    translate: 0 30px;
    transition: translate 0.4s ease-out;
}

/* Adicionada pelo GameOverUI.cs um frame depois de a tela aparecer. */
.go-raiz--visivel {
    opacity: 1;
}

.go-raiz--visivel .go-moldura {
    translate: 0 0;
}

.go-titulo {
    margin: 0;
    color: rgb(255, 70, 120);
    font-size: 96px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: rgb(120, 0, 60);
    letter-spacing: 6px;
    text-shadow: -8px 6px 0 rgb(125, 25, 85);
}

.go-subtitulo {
    margin: 0 0 16px 0;
    color: var(--lilas);
    font-size: 28px;
    -unity-text-align: middle-center;
}

/* Linha com os cards do resumo. */
.go-resumo {
    flex-direction: row;
    align-self: stretch;
    margin: 0 0 14px 0;
}

.go-stat {
    flex-grow: 1;
    flex-basis: 0;
    margin: 0 8px;
    padding: 8px 6px 10px 6px;
    align-items: center;
    background-color: rgba(20, 10, 32, 0.75);
    border-color: rgba(193, 112, 207, 0.65);
    border-width: 3px;
    border-bottom-width: 7px;
    border-radius: 14px;
}

.go-valor {
    margin: 0;
    color: rgb(255, 255, 255);
    font-size: 50px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.go-rotulo {
    margin: 0;
    color: var(--lilas);
    font-size: 20px;
    letter-spacing: 4px;
    -unity-text-align: middle-center;
}

/* Recorde e ranking (só no Infinito). */
.go-linha {
    margin: 0 0 6px 0;
    color: rgb(255, 255, 255);
    font-size: 28px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.go-ranking {
    color: var(--amarelo);
}

/* Linha com os 3 botões. */
.go-botoes {
    flex-direction: row;
    align-self: stretch;
    justify-content: center;
    margin-top: 10px;
}

/* Layout dos botões; a aparência (cores, borda e hover) é do Tema.uss. */
.go-raiz .go-botao {
    flex-grow: 1;
    flex-basis: 0;
    margin: 0 8px;
    padding: 14px 10px;
    font-size: 30px;
}
