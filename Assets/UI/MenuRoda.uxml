<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Tema.uss?fileID=7433441132597879392&amp;guid=f9dbec2f11f65c7caf30d098af8936ce&amp;type=3#Tema"/>
    <Style src="project://database/Assets/UI/Menu.uss?fileID=7433441132597879392&amp;guid=abef5d96a7eebb3419759bb589f9e0c4&amp;type=3#Menu"/>
    <ui:VisualElement name="MainMenu" style="flex-grow: 1; align-items: center; justify-content: center; display: flex;">
        <!-- Menu principal em roda: bola grande à esquerda, opções em arco (posicionadas pelo RodaDeOpcoes.cs), faixa de destaque e rodapé
             com a descrição. "Reset_btt" é o nome antigo do botão, hoje abre as Configurações. O lado direito fica livre para o fundo animado. -->
        <ui:VisualElement name="containerMenu" class="roda-raiz">
            <ui:VisualElement name="BolaMenu" class="roda-bola" picking-mode="Ignore"/>
            <ui:VisualElement name="FaixaMenu" class="roda-faixa" picking-mode="Ignore"/>
            <ui:Label text="Menu Principal" name="Title" class="roda-titulo" picking-mode="Ignore"/>
            <ui:VisualElement name="RodaOpcoes" class="roda-opcoes" picking-mode="Ignore">
                <ui:Button text="Jogar" name="Play_btt"/>
                <ui:Button text="Ranking" name="Leaderboard_btt"/>
                <ui:Button text="Configurações" name="Reset_btt"/>
                <ui:Button text="Sair" name="Quit_btt"/>
            </ui:VisualElement>
            <ui:VisualElement name="RodaRodape" class="roda-rodape" picking-mode="Ignore">
                <ui:Label text="" name="RodaDescricao" class="roda-descricao" picking-mode="Ignore"/>
                <ui:Label text="Setas ou W/S, ou o scroll, mudam. Enter ou clique confirmam." class="roda-dica" picking-mode="Ignore"/>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Play: escolha do modo (escondido; o MenuManager.cs troca os painéis por style.display) -->
        <ui:VisualElement name="PainelModo" class="moldura-menu">
            <ui:Label text="Escolha o modo" name="TituloModo" class="titulo-painel"/>
            <ui:TextField label="Seu nome" name="CampoNome" max-length="10" class="campo-nome"/>
            <ui:VisualElement name="LinhaCards" class="linha-cards">
                <ui:VisualElement name="Card_Campanha" class="card-modo">
                    <ui:Label text="CAMPANHA" class="card-titulo" picking-mode="Ignore"/>
                    <ui:Label text="15 ondas e 3 chefes. Derrote o chefe final da onda 15 para vencer." class="card-descricao" picking-mode="Ignore"/>
                </ui:VisualElement>
                <ui:VisualElement name="Card_Infinito" class="card-modo">
                    <ui:Label text="INFINITO" class="card-titulo" picking-mode="Ignore"/>
                    <ui:Label text="Ondas sem fim e chefes cada vez mais fortes. Sua maior onda entra no ranking." class="card-descricao" picking-mode="Ignore"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Button text="Voltar" name="VoltarModo_btt" class="button button-voltar"/>
        </ui:VisualElement>

        <!-- Leaderboard: top 5 local do Infinito (as linhas são criadas pelo MenuManager.cs em ListaLeaderboard) -->
        <ui:VisualElement name="PainelLeaderboard" class="moldura-menu">
            <ui:Label text="Ranking" name="TituloLeaderboard" class="titulo-painel"/>
            <ui:VisualElement name="ListaLeaderboard" class="lista-ranking"/>
            <ui:Button text="Voltar" name="VoltarLeaderboard_btt" class="button button-voltar"/>
        </ui:VisualElement>

        <!-- Settings: volumes de 0 a 100 (Geral, Música e Efeitos) -->
        <ui:VisualElement name="PainelSettings" class="moldura-menu">
            <ui:Label text="Configurações" name="TituloSettings" class="titulo-painel"/>
            <ui:VisualElement name="AreaConfig" class="area-config">
                <ui:VisualElement class="linha-config">
                    <ui:Label text="Tela cheia" class="rotulo-config"/>
                    <ui:Toggle name="Toggle_TelaCheia" class="toggle-config"/>
                </ui:VisualElement>
                <ui:VisualElement class="linha-config">
                    <ui:Label text="Geral" class="rotulo-config"/>
                    <ui:SliderInt name="Slider_Geral" low-value="0" high-value="100" value="100" class="slider-config"/>
                    <ui:Label text="100" name="Valor_Geral" class="valor-config"/>
                </ui:VisualElement>
                <ui:VisualElement class="linha-config">
                    <ui:Label text="Música" class="rotulo-config"/>
                    <ui:SliderInt name="Slider_Musica" low-value="0" high-value="100" value="100" class="slider-config"/>
                    <ui:Label text="100" name="Valor_Musica" class="valor-config"/>
                </ui:VisualElement>
                <ui:VisualElement class="linha-config">
                    <ui:Label text="Efeitos" class="rotulo-config"/>
                    <ui:SliderInt name="Slider_Efeitos" low-value="0" high-value="100" value="100" class="slider-config"/>
                    <ui:Label text="100" name="Valor_Efeitos" class="valor-config"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Button text="Voltar" name="VoltarSettings_btt" class="button button-voltar"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
