<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Menu.uss?fileID=7433441132597879392&amp;guid=abef5d96a7eebb3419759bb589f9e0c4&amp;type=3#Menu"/>
    <!-- Menu de pausa (MenuDePausa.cs): escondido até o jogo entrar no estado Pause. O fundo escurece o jogo por trás. -->
    <ui:VisualElement name="PausaRaiz" style="flex-grow: 1; align-items: center; justify-content: center; display: none; background-color: rgba(8, 4, 14, 0.6);">
        <!-- Mesmo visual do containerMenu do menu principal (Wagner), com o título "Pausa". -->
        <ui:GroupBox name="ContainerPausa" style="flex-grow: 1; flex-shrink: 0; min-width: 50%; min-height: 50%; max-height: 70%; max-width: 70%; -unity-text-outline-width: 0; -unity-text-outline-color: rgb(255, 0, 236); color: rgba(255, 255, 255, 0.894); background-color: rgba(41, 28, 53, 0.439); border-left-color: rgba(125, 38, 255, 0.71); border-right-color: rgba(125, 38, 255, 0.71); border-top-color: rgba(125, 38, 255, 0.71); border-bottom-color: rgba(125, 38, 255, 0.71); border-top-width: 12px; border-right-width: 12px; border-bottom-width: 12px; border-left-width: 12px; border-top-left-radius: 25px; border-top-right-radius: 25px; border-bottom-right-radius: 25px; border-bottom-left-radius: 25px; backdrop-filter: none;">
            <ui:Label text="Pausa" name="TituloPausa" style="color: rgb(193, 112, 207); font-size: 180px; -unity-text-align: middle-center; flex-shrink: 1; -unity-font-style: bold; flex-direction: column; -unity-text-outline-width: 8px; -unity-text-outline-color: rgb(153, 0, 178); letter-spacing: 8px; text-shadow: -18px 10px 0 rgb(197, 126, 221); -unity-text-auto-size: best-fit 100px 180px; padding-top: 25px; padding-bottom: 25px; padding-left: 10px; padding-right: 10px; margin-top: 0; margin-left: 0; margin-right: 0; margin-bottom: 0;"/>
            <ui:GroupBox name="ContainerBotoesPausa" style="padding-left: 0; padding-bottom: 0; margin-top: 40px; margin-bottom: 40px; margin-left: 20px; margin-right: 20px; padding-top: 0; align-self: auto; justify-content: center; align-items: center; align-content: flex-start; flex-direction: column; height: auto; flex-grow: 1; backdrop-filter: none;">
                <ui:Button text="Continuar" name="Continuar_btt" class="button" style="border-bottom-right-radius: 45px; backdrop-filter: none; background-image: none;"/>
                <ui:Button text="Settings" name="SettingsPausa_btt" class="button" style="background-image: none;"/>
                <ui:Button text="Menu" name="MenuPausa_btt" class="button" style="background-image: none;"/>
                <ui:Button text="Exit" name="SairPausa_btt" class="button" style="background-image: none;"/>
            </ui:GroupBox>
        </ui:GroupBox>

        <!-- Settings: os mesmos volumes do menu principal (mesmos names, ligados pelo PainelDeVolumes.cs). -->
        <ui:VisualElement name="PainelSettingsPausa" class="moldura-menu">
            <ui:Label text="Settings" name="TituloSettingsPausa" class="titulo-painel"/>
            <ui:VisualElement name="AreaConfigPausa" class="area-config">
                <ui:VisualElement class="linha-config">
                    <ui:Label text="Geral" class="rotulo-config"/>
                    <ui:SliderInt name="Slider_Geral" low-value="0" high-value="100" value="100" class="slider-config"/>
                    <ui:Label text="100" name="Valor_Geral" class="valor-config"/>
                </ui:VisualElement>
                <ui:VisualElement class="linha-config">
                    <ui:Label text="Música" class="rotulo-config"/>
                    <ui:SliderInt name="Slider_Musica" low-value="0" high-value="100" value="100" class="slider-config"/>
                    <ui:Label text="100" name="Valor_Musica" class="valor-config"/>
                </ui:VisualElement>
                <ui:VisualElement class="linha-config">
                    <ui:Label text="Efeitos" class="rotulo-config"/>
                    <ui:SliderInt name="Slider_Efeitos" low-value="0" high-value="100" value="100" class="slider-config"/>
                    <ui:Label text="100" name="Valor_Efeitos" class="valor-config"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Button text="Voltar" name="VoltarSettingsPausa_btt" class="button button-voltar" style="background-image: none;"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
