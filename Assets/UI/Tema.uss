/* Tema único das telas (menu, pausa, game over, vitória, level up e controles): paleta, moldura e estado dos botões.
   Cada UXML importa este arquivo antes do seu próprio USS. 

   Paleta (valores usados literalmente nas USS; variáveis CSS não resolvem nestes painéis):
   roxo: rgba(125, 38, 255, 0.71)
   fundo-moldura: rgba(41, 28, 53, 0.88)
   botao-fundo: rgba(67, 25, 92, 0.85)
   botao-hover: rgba(155, 60, 235, 0.95)
   borda-botao: rgb(125, 38, 255)
   amarelo: rgb(255, 221, 87)
   lilas: rgb(226, 160, 244)
   titulo: rgb(193, 112, 207)
   sombra-titulo: rgb(153, 0, 178)
   texto: rgb(255, 255, 255) */


/* ---- Moldura única ---- */

.moldura-tema,
.moldura-menu,
.go-moldura,
.vit-moldura {
    color: rgb(255, 255, 255);
    background-color: rgba(41, 28, 53, 0.88);
    border-color: rgba(125, 38, 255, 0.71);
    border-width: 10px;
    border-radius: 25px;
}

/* ---- Botões: um estado só para todos ----
   Os seletores com .unity-button (mais fortes que o estilo padrão do botão) vencem inclusive no :hover e no :active. */

.unity-button.button,
.unity-button.go-botao,
.unity-button.vit-botao,
.unity-button.lv-confirmar,
.unity-button.IniciarBtn,
.unity-button.roda-item {
    color: rgb(255, 255, 255);
    background-color: rgba(67, 25, 92, 0.85);
    background-image: none;
    border-color: rgb(125, 38, 255);
    border-width: 4px;
    border-radius: 18px;
    -unity-font-style: bold;
    -unity-text-outline-width: 0;
    text-shadow: 0 0 0 rgba(0, 0, 0, 0);
    scale: 1 1;
    transition-property: scale, background-color, border-color, color;
    transition-duration: 0.12s;
}

.unity-button.button:hover,
.unity-button.go-botao:hover,
.unity-button.vit-botao:hover,
.unity-button.lv-confirmar:hover,
.unity-button.IniciarBtn:hover,
.unity-button.roda-item--selecionado {
    color: rgb(255, 221, 87);
    background-color: rgba(155, 60, 235, 0.95);
    border-color: rgb(255, 221, 87);
    scale: 1.04 1.04;
}

.unity-button.button:active,
.unity-button.go-botao:active,
.unity-button.vit-botao:active,
.unity-button.lv-confirmar:active,
.unity-button.IniciarBtn:active {
    color: rgb(255, 221, 87);
    background-color: rgba(155, 60, 235, 0.95);
    border-color: rgb(255, 221, 87);
    scale: 0.98 0.98;
}

/* Botão desligado (Confirmar do level up antes de escolher um card). */
.unity-button.lv-confirmar:disabled {
    color: rgba(255, 255, 255, 0.5);
    background-color: rgba(41, 28, 53, 0.7);
    border-color: rgba(125, 38, 255, 0.45);
    scale: 1 1;
}

/* ---- Cards (escolha do modo e level up): mesma linguagem de hover dos botões ---- */

.card-modo:hover,
.lv-cards .lv-card:hover {
    background-color: rgba(155, 60, 235, 0.95);
    scale: 1.04 1.04;
}

.card-modo:hover {
    border-color: rgb(255, 221, 87);
}

/* ---- Animação de abertura das janelas (AnimacaoDeJanela.cs) ----
   O código adiciona "anim-transicao" e uma classe "anim-ini-*" (estado de partida); ao tirar a "anim-ini-*", a transição leva
   o elemento ao estado normal. "anim-transicao" sai ao fim, para não atrapalhar hover e o giro da bola.
   Os seletores compostos vencem o transition-property de .roda-bola, dos cards e do botão Confirmar (mais fortes). */

.anim-transicao,
.roda-bola.anim-transicao,
.card-modo.anim-transicao,
.lv-cards .lv-card.anim-transicao,
.unity-button.lv-confirmar.anim-transicao {
    transition-property: opacity, translate, scale, rotate;
    transition-duration: 0.28s;
    transition-timing-function: ease-out-cubic;
}

/* Ajustes de duração e curva (classeExtra do Tocar), depois da regra acima para vencer. */
.anim-transicao.anim-rapida,
.roda-bola.anim-transicao.anim-rapida {
    transition-duration: 0.18s;
}

.anim-transicao.anim-lenta,
.roda-bola.anim-transicao.anim-lenta {
    transition-duration: 0.5s;
}

.anim-transicao.anim-back-media {
    transition-duration: 0.4s;
    transition-timing-function: ease-out-back;
}

.anim-transicao.anim-back,
.lv-cards .lv-card.anim-transicao.anim-back {
    transition-timing-function: ease-out-back;
}

/* Estados de partida */
.anim-ini-fade { opacity: 0; }
.anim-ini-bola { translate: -400px 0; opacity: 0; }
.anim-ini-direita { translate: 160px 0; opacity: 0; }
.anim-ini-esquerda { translate: -160px 0; opacity: 0; }
.anim-ini-sobe60 { translate: 0 60px; opacity: 0; }
.anim-ini-sobe80 { translate: 0 80px; opacity: 0; }
.anim-ini-sobe120 { translate: 0 120px; opacity: 0; }
.anim-ini-cai { translate: 0 -80px; opacity: 0; }
.anim-ini-pop { scale: 0.9 0.9; opacity: 0; }
.anim-ini-pop-grande { scale: 0.6 0.6; opacity: 0; }
.anim-ini-zoom { scale: 1.12 1.12; opacity: 0; }
