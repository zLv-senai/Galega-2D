<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="HudProgressao.uss" />
    <ui:VisualElement name="HudRaiz" class="hud-raiz" picking-mode="Ignore">

        <!-- Canto superior esquerdo: level, barra de XP, vida e escudo -->
        <ui:VisualElement name="PainelStatus" class="painel-status" picking-mode="Ignore">
            <ui:Label name="LevelLabel" text="Level 1" class="hud-texto hud-level" picking-mode="Ignore" />
            <ui:VisualElement name="XpFundo" class="xp-fundo" picking-mode="Ignore">
                <ui:VisualElement name="XpPreenchimento" class="xp-preenchimento" picking-mode="Ignore" />
            </ui:VisualElement>
            <!-- Waves: "Wave N/15" (Campanha) ou "Wave N  Recorde R" (Infinito) e quantos inimigos faltam (o HudProgressao.cs esconde se não houver GerenciadorDeWaves) -->
            <ui:VisualElement name="WaveBloco" class="wave-bloco" picking-mode="Ignore">
                <ui:Label name="WaveLabel" text="Wave 1/15" class="hud-texto hud-wave" picking-mode="Ignore" />
                <ui:Label name="InimigosLabel" text="Inimigos: 6" class="hud-texto" picking-mode="Ignore" />
            </ui:VisualElement>
            <!-- Ameaça: enche com abates e com o tempo; ao encher, chama o boss (o HudProgressao.cs esconde se não houver ControladorDeBoss ou se houver GerenciadorDeWaves) -->
            <ui:VisualElement name="AmeacaBloco" class="ameaca-bloco" picking-mode="Ignore">
                <ui:Label name="AmeacaLabel" text="AMEAÇA" class="hud-texto ameaca-titulo" picking-mode="Ignore" />
                <ui:VisualElement name="AmeacaFundo" class="ameaca-fundo" picking-mode="Ignore">
                    <ui:VisualElement name="AmeacaPreenchimento" class="ameaca-preenchimento" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Label name="VidaLabel" text="Vida 100/100" class="hud-texto" picking-mode="Ignore" />
            <ui:Label name="EscudoLabel" text="Escudo x0" class="hud-texto hud-escudo" picking-mode="Ignore" />
        </ui:VisualElement>

        <!-- À direita do painel de level: power-ups ativos e o tempo que falta (linhas criadas pelo HudProgressao.cs) -->
        <ui:VisualElement name="PowerUpsAtivos" class="powerups-ativos" picking-mode="Ignore" />

        <!-- Centro-alto: aviso de level up (escondido por padrão; o HudProgressao.cs mostra por 1,5 s) -->
        <ui:VisualElement name="LevelUpPainel" class="levelup-painel" picking-mode="Ignore">
            <ui:Label name="LevelUpTitulo" text="LEVEL UP!" class="levelup-titulo" picking-mode="Ignore" />
            <ui:Label name="LevelUpNivel" text="Level 2" class="hud-texto levelup-nivel" picking-mode="Ignore" />
        </ui:VisualElement>

        <!-- Centro-alto: alerta de boss (escondido por padrão; o HudProgressao.cs mostra piscando durante o alerta) -->
        <ui:Label name="BossAlerta" text="BOSS SE APROXIMANDO" class="boss-alerta" picking-mode="Ignore" />

        <!-- Centro: anúncio da wave "WAVE N" ou "WAVE N - BOSS" (escondido por padrão; o HudProgressao.cs mostra durante o anúncio) -->
        <ui:Label name="WaveAnuncio" text="WAVE 1" class="wave-anuncio" picking-mode="Ignore" />

        <!-- Topo central: barra de vida do boss (escondida por padrão; só aparece com boss vivo) -->
        <ui:VisualElement name="BossBarra" class="boss-barra" picking-mode="Ignore">
            <ui:Label name="BossTitulo" text="BOSS 1/3" class="hud-texto boss-titulo" picking-mode="Ignore" />
            <ui:VisualElement name="BossVidaFundo" class="boss-vida-fundo" picking-mode="Ignore">
                <ui:VisualElement name="BossVidaPreenchimento" class="boss-vida-preenchimento" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Centro-baixo: nome do power-up pego (escondido por padrão; o HudProgressao.cs mostra por 1,5 s) -->
        <ui:Label name="PowerUpAviso" text="+ Power-up" class="powerup-aviso" picking-mode="Ignore" />

    </ui:VisualElement>
</ui:UXML>
