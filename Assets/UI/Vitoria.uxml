<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Tema.uss?fileID=7433441132597879392&amp;guid=f9dbec2f11f65c7caf30d098af8936ce&amp;type=3#Tema"/>
    <Style src="Vitoria.uss" />
    <!-- Tela cheia escurecida; escondida por padrão (o VitoriaUI.cs mostra quando o estado vira Vitoria) -->
    <ui:VisualElement name="VitoriaRaiz" class="vit-raiz">
        <ui:VisualElement name="VitoriaMoldura" class="vit-moldura">
            <ui:Label name="VitoriaTitulo" text="VITÓRIA!" class="vit-titulo" />
            <ui:Label name="VitoriaSubtitulo" text="Você derrotou os 3 bosses" class="vit-subtitulo" />
            <ui:Button name="VitoriaJogarDeNovo" text="Jogar de novo" class="vit-botao" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
