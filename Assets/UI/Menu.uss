:root {
}

.button {
    justify-content: flex-start;
    align-self: center;
    align-content: auto;
    align-items: stretch;
    flex-grow: 0;
    min-width: auto;
    min-height: auto;
    max-width: none;
    width: 50%;
    height: auto;
    font-size: 45px;
    -unity-font-style: bold;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(153, 0, 178);
    text-shadow: -10px 8px 0 rgb(124, 79, 139);
    color: rgba(27, 27, 27, 0);
    background-color: rgba(106, 56, 101, 0);
    border-top-width: 3px;
    border-right-width: 6px;
    border-bottom-width: 12px;
    border-left-width: 6px;
    border-top-left-radius: 45px;
    border-top-right-radius: 0;
    border-bottom-right-radius: 45px;
    border-bottom-left-radius: 0;
    border-color: rgb(193, 112, 207);
    letter-spacing: 10px;
    padding-bottom: 20px;
    margin-bottom: 45px;
    padding-top: 20px;
}

.button:hover {
    -unity-text-outline-color: rgb(226, 18, 198);
    text-shadow: -10px 8px 0 rgb(203, 129, 228);
    color: rgba(143, 50, 187, 0.86);
    background-color: rgba(67, 25, 92, 0.56);
    border-color: rgb(227, 75, 247);
    border-right-width: 8px;
    border-bottom-width: 18px;
    margin-bottom: 39px;
    margin-right: 2px;
}