/* Layout dos botões. Cores, borda e hover vêm do Tema.uss (estado único de todas as telas). */
.button {
    justify-content: center;
    align-self: center;
    align-content: auto;
    align-items: center;
    flex-grow: 0;
    /* Integração: largura mínima para o texto "Configurações" caber no botão. */
    min-width: 460px;
    min-height: auto;
    max-width: none;
    width: 50%;
    height: auto;
    font-size: 45px;
    letter-spacing: 4px;
    padding-top: 14px;
    padding-bottom: 14px;
    margin-bottom: 24px;
}

/* ================================================================================================
   Integração: painéis novos do menu (Escolha o modo, Leaderboard e Settings), no mesmo estilo acima.
   Os painéis ficam escondidos (display: none); o MenuManager.cs mostra um de cada vez.
   ================================================================================================ */

/* Moldura dos painéis: cor, borda e raio vêm do Tema.uss (.moldura-tema). */
.moldura-menu {
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    width: 80%;
    height: 85%;
    padding: 18px 28px 10px 28px;
}

/* Título do painel: o "Menu" do Wagner em tamanho menor. */
.titulo-painel {
    flex-shrink: 0;
    margin: 0 0 14px 0;
    padding: 6px 10px;
    color: rgb(193, 112, 207);
    font-size: 72px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 4px;
    -unity-text-outline-color: rgb(153, 0, 178);
    letter-spacing: 6px;
    text-shadow: -8px 6px 0 rgb(197, 126, 221);
}

/* Botão Voltar: o .button do Wagner, só mais estreito e com fonte menor (precisa vir depois do .button). */
.button-voltar {
    flex-shrink: 0;
    width: 40%;
    min-width: 300px;
    font-size: 40px;
    margin-bottom: 14px;
}

/* ---- Escolha o modo ---- */

.campo-nome {
    flex-shrink: 0;
    width: 70%;
    margin: 0 0 16px 0;
    align-items: center;
}

.campo-nome .unity-base-field__label {
    min-width: 200px;
    margin: 0;
    padding: 0 12px 0 0;
    color: rgba(255, 255, 255, 0.95);
    font-size: 34px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.campo-nome .unity-base-text-field__input {
    flex-grow: 1;
    margin: 0;
    padding: 6px 14px;
    color: rgb(255, 255, 255);
    font-size: 34px;
    -unity-text-align: middle-left;
    background-color: rgba(30, 14, 46, 0.9);
    border-color: rgb(125, 38, 255);
    border-width: 3px;
    border-radius: 14px;
    --unity-cursor-color: rgb(255, 255, 255);
}

.campo-nome:focus .unity-base-text-field__input {
    border-color: rgb(255, 221, 87);
}

/* "Piloto" de fundo (placeholder): mais apagado que o texto digitado, para não parecer um nome já escrito. */
.campo-nome .unity-base-text-field__input--placeholder {
    color: rgba(255, 255, 255, 0.45);
}

/* Fase apagada do cursor piscando (o MenuManager liga e desliga esta classe). */
.campo-nome.campo-nome--cursor-apagado .unity-base-text-field__input {
    --unity-cursor-color: rgba(0, 0, 0, 0);
}

.linha-cards {
    flex-direction: row;
    flex-grow: 1;
    flex-shrink: 1;
    align-self: stretch;
    margin-bottom: 14px;
}

/* Card do modo: botão grande clicável, com a mesma linguagem dos botões (hover no Tema.uss). */
.card-modo {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    margin: 0 12px;
    padding: 16px 20px;
    align-items: center;
    justify-content: center;
    background-color: rgba(67, 25, 92, 0.85);
    border-color: rgb(125, 38, 255);
    border-width: 4px;
    border-radius: 18px;
    transition-property: background-color, border-color, scale;
    transition-duration: 0.12s;
}

.card-modo:active {
    scale: 0.98 0.98;
}

.card-titulo {
    margin: 0 0 10px 0;
    color: rgb(226, 160, 244);
    font-size: 52px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: rgb(153, 0, 178);
    letter-spacing: 4px;
    text-shadow: -5px 4px 0 rgb(124, 79, 139);
}

.card-descricao {
    color: rgba(255, 255, 255, 0.95);
    font-size: 28px;
    -unity-text-align: upper-center;
    white-space: normal;
}

/* ---- Leaderboard ---- */

.lista-ranking {
    flex-grow: 1;
    flex-shrink: 1;
    align-self: stretch;
    align-items: center;
    justify-content: center;
}

.linha-ranking {
    margin: 6px 0;
    color: rgb(255, 255, 255);
    font-size: 38px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(60, 10, 80);
}

.linha-ranking-topo {
    color: rgb(255, 221, 87);
}

.linha-ranking-vazio {
    color: rgba(255, 255, 255, 0.7);
    -unity-font-style: normal;
}

/* ---- Settings ---- */

.area-config {
    flex-grow: 1;
    flex-shrink: 1;
    align-self: stretch;
    align-items: center;
    justify-content: center;
}

.linha-config {
    flex-direction: row;
    align-items: center;
    width: 92%;
    margin: 0 0 22px 0;
}

.rotulo-config {
    width: 190px;
    color: rgba(255, 255, 255, 0.95);
    font-size: 40px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(60, 10, 80);
}

.valor-config {
    width: 100px;
    color: rgb(255, 221, 87);
    font-size: 40px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
}

.slider-config {
    flex-grow: 1;
    min-height: 40px;
    margin: 0 18px;
}

.slider-config .unity-base-slider__tracker {
    background-color: rgba(125, 38, 255, 0.71);
    border-color: rgb(125, 38, 255);
}

.slider-config .unity-base-slider__dragger {
    background-color: rgb(255, 221, 87);
    border-color: rgb(255, 255, 255);
}
/* Toggle "Tela cheia": caixa do tamanho dos sliders, marcada em amarelo. */
.toggle-config {
    flex-grow: 1;
    margin: 0 18px;
}

.toggle-config .unity-toggle__input {
    align-items: center;
}

.toggle-config .unity-toggle__checkmark {
    width: 44px;
    height: 44px;
    background-color: rgba(30, 14, 46, 0.9);
    border-color: rgb(125, 38, 255);
    border-width: 3px;
    border-radius: 10px;
    -unity-background-image-tint-color: rgb(41, 28, 53);
}

.toggle-config:checked .unity-toggle__checkmark {
    background-color: rgb(255, 221, 87);
}

/* ================================================================================================
   Roda de opções (MenuRoda.uxml e PausaRoda.uxml), na resolução de referência 1920x1080.
   Quem posiciona os itens (translate, scale e opacity) é o RodaDeOpcoes.cs; aqui ficam o visual e a transição.
   ================================================================================================ */

.roda-raiz {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* Bola grande, metade fora da tela; a arte provisória pode ser trocada mantendo o caminho do arquivo. */
.roda-bola {
    position: absolute;
    left: -750px;
    top: -200px;
    width: 1250px;
    height: 1250px;
    background-image: url("project://database/Assets/Images/Menu/bola-menu.png");
    -unity-background-scale-mode: scale-to-fit;
    transition-property: rotate;
    transition-duration: 0.35s;
    transition-timing-function: ease-out-cubic;
}

/* Entrada da nave (EntradaDaNave.cs): o planeta sai pela esquerda. O seletor com .roda-raiz vence o
   .roda-bola.anim-transicao do Tema.uss (transition-property e duração). */
.roda-raiz .roda-bola.roda-bola--saindo {
    translate: -1400px 0;
    transition-property: translate;
    transition-duration: 0.6s;
    transition-timing-function: ease-in-cubic;
}

/* Faixa suave atrás da opção selecionada (centro em y = 425): gradiente da borda da bola (x = 500) até x = 1100. */
.roda-faixa {
    position: absolute;
    left: 500px;
    width: 600px;
    top: 361px;
    height: 128px;
    background-image: url("project://database/Assets/Images/Menu/faixa-selecao.png");
    -unity-background-scale-mode: stretch-to-fill;
}

.roda-titulo {
    position: absolute;
    left: 60px;
    top: 30px;
    margin: 0;
    color: rgb(193, 112, 207);
    font-size: 72px;
    -unity-font-style: bold;
    -unity-text-outline-width: 4px;
    -unity-text-outline-color: rgb(153, 0, 178);
    letter-spacing: 4px;
}

.roda-opcoes {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* Item da roda: botão posicionado por código a partir do canto superior esquerdo. */
.unity-button.roda-item {
    position: absolute;
    left: 0;
    top: 0;
    width: 400px;
    height: 110px;
    margin: 0;
    padding: 0 0 0 30px;
    font-size: 46px;
    -unity-text-align: middle-left;
    transition-property: translate, scale, opacity, background-color, border-color, color;
    transition-duration: 0.18s;
}

/* Caixa compacta centralizada embaixo (860x110, a 30 do fundo). */
.roda-rodape {
    position: absolute;
    left: 50%;
    margin-left: -430px;
    width: 860px;
    height: 110px;
    bottom: 30px;
    padding: 8px 24px 0 24px;
    justify-content: center;
    background-color: rgba(41, 28, 53, 0.88);
    border-width: 4px;
    border-color: rgba(125, 38, 255, 0.71);
    border-radius: 18px;
}

.roda-descricao {
    margin: 0 0 4px 0;
    color: rgb(255, 255, 255);
    font-size: 30px;
    white-space: normal;
}

.roda-dica {
    margin: 0;
    color: rgb(226, 160, 244);
    font-size: 18px;
}

/* Dica solta, para a pausa em roda (que não tem rodapé). */
.roda-dica-solta {
    position: absolute;
    left: 70px;
    bottom: 40px;
}
